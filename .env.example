# X (Twitter) API - https://developer.x.com/
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_USER_ID=

# Threads (Meta) API - https://developers.facebook.com/docs/threads
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# 通知設定（いずれか1つ以上を設定）
# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=

# ntfy.sh（スマホ通知、無料）- トピック名を任意に設定
NTFY_TOPIC=birthday-notify

# SMTP（メール通知）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# タイムゾーン（デフォルト: Asia/Tokyo）
TZ=Asia/Tokyo
